# /etc/systemd/system/tilefolio.service — installed by deploy/bootstrap.sh
# The app binds 127.0.0.1:8000 only; Caddy is the only public listener (80/443).
[Unit]
Description=Tilefolio API
After=network-online.target
Wants=network-online.target

[Service]
User=tilefolio
Group=tilefolio
# /opt/tilefolio/current is a symlink to the live release (see tilefolio-deploy).
WorkingDirectory=/opt/tilefolio/current/backend
EnvironmentFile=/etc/tilefolio/env
Environment=TF_HOST=127.0.0.1 TF_PORT=8000 TF_DATA_DIR=/var/lib/tilefolio
ExecStart=/opt/tilefolio/current/backend/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=3

# Hardening
StateDirectory=tilefolio
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/tilefolio

[Install]
WantedBy=multi-user.target
