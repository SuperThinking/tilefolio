# Copy to backend/.env and fill in. All optional for local use.
TF_HOST=127.0.0.1            # keep localhost; put Caddy/nginx in front on a VPS
TF_PORT=8000
TF_PUBLIC_ORIGIN=http://localhost:8000
TF_SESSION_SECRET=           # REQUIRED in prod: python -c "import secrets;print(secrets.token_urlsafe(32))"
TF_COOKIE_SECURE=0           # 1 in prod (HTTPS)
TF_GOOGLE_CLIENT_ID=         # enables optional Google sign-in / sync
# Frontend origin(s) when the SPA is hosted elsewhere (e.g. GitHub Pages), comma-separated
TF_CORS_ORIGINS=
TF_FINNHUB_API_KEY=          # optional; US quotes fall back to Yahoo without it
TF_QUOTE_TTL=45
TF_MF_NAV_REFRESH=21600
TF_LOAD_INSTRUMENTS=1
