{
  "name": "tilefolio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "\"$npm_node_execpath\" node_modules/vite/bin/vite.js",
    "build": "\"$npm_node_execpath\" node_modules/vite/bin/vite.js build",
    "preview": "\"$npm_node_execpath\" node_modules/vite/bin/vite.js preview",
    "check": "\"$npm_node_execpath\" node_modules/svelte-check/bin/svelte-check --tsconfig ./jsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.4",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
